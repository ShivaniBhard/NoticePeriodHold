				info "ShivaniN";
				info net_pay;
			}
		}
		// Null safety for base_days
		if(base_days == null || base_days == 0)
		{
			base_days = 30;
			// safe default OR fetch correctly
		}
		// Null safety for net_pay
		if(net_pay == null)
		{
			net_pay = 0;
		}
		// Step 3: Calculate per day from net pay
		perday = net_pay / base_days;
		info "ShivaniD";
		info no_of_days;
		info "ShivaniP";
		info perday;
		if(empType == "Equity Partner")
		{
			on_hold_amount = (perday * no_of_days * 40) / 100;
		}
		else if(empCTC <= 1500000)
		{
			on_hold_amount = (perday * no_of_days * 20) / 100;
			info on_hold_amount;
		}
		else if(empCTC > 1500000 && empCTC <= 3000000)
		{
			on_hold_amount = (perday * no_of_days * 30) / 100;
		}
		else if(empCTC > 3000000)
		{
			on_hold_amount = (perday * no_of_days * 50) / 100;
		}
		// ✅ CRM PART (MOVED INSIDE LOOP)
		if(on_hold_amount != null && on_hold_amount > 0)
		{
			if(empEmail != "")
			{
				crmResp = zoho.crm.searchRecords("FCC_Employee","(Email:equals:" + empEmail + ")");
