					holdMap.put("Employee",fccEmpId);
					holdMap.put("Year",payrollYear);
					holdMap.put("Month",payrollMonth);
					createResp = zoho.crm.createRecord("Hold_Salary_Amount",holdMap);
					info createResp;
				}
				else
				{
					info "Employee not found in CRM: " + empEmail;
				}
			}
		}
		importCSV = importCSV + empNo + "," + on_hold_amount + "\n";
	}
